{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip"
	],
	"mappings": {
		"wp-content/plugins/dumpseo": "."
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli wp plugin activate dumpseo && npx wp-env run tests-cli wp plugin activate dumpseo"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true
	}
}
