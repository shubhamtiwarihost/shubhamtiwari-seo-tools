{
	"name": "shubhamtiwarihost/dumpseo",
	"description": "DumpSEO — an original, privacy-respecting SEO plugin for WordPress.",
	"type": "wordpress-plugin",
	"version": "1.0.2",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.4",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload-dev": {
		"psr-4": {
			"DumpSEO\\": "src/",
			"DumpSEO\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "find dumpseo.php uninstall.php src tests bin -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit --testsuite unit",
		"test:integration": "phpunit -c phpunit-integration.xml.dist",
		"check-versions": "php bin/check-versions.php",
		"ci": [
			"@lint",
			"@check-versions",
			"@phpcs",
			"@phpstan",
			"@test"
		]
	}
}
